{
  "expo": {
    "name": "247Market",
    "slug": "247Market",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "247Market",
    "icon": "./assets/icon.svg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.classifed.mobile"
    },
    "android": {
      "package": "com.classifed.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "247Market needs access to your photos to upload ad images.",
          "cameraPermission": "247Market needs access to your camera to take ad photos."
        }
      ],
      [
        "expo-secure-store"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
